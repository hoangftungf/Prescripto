{
  "info": {
    "_postman_id": "b2fc5e31-6722-4810-8c0d-22d9c5b7ebf3",
    "name": "Prescripto Admin API Collection",
    "description": "Collection API cho phần Admin trong hệ thống Prescripto",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "    pm.environment.set(\"adminToken\", jsonData.token);",
                  "    console.log(\"Token đã được lưu: \" + jsonData.token);",
                  "} else {",
                  "    console.log(\"Lỗi khi đăng nhập: \" + jsonData.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"greatstack123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "description": "Đăng nhập vào hệ thống với tài khoản Admin. Thông tin đăng nhập được cấu hình trong file .env"
          }
        }
      ],
      "description": "API xác thực dành cho Admin"
    },
    {
      "name": "2. Quản lý Bác sĩ",
      "item": [
        {
          "name": "Thêm Bác sĩ mới",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Bác sĩ Test",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "doctor.test@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                },
                {
                  "key": "speciality",
                  "value": "General_physician",
                  "type": "text"
                },
                {
                  "key": "degree",
                  "value": "MBBS",
                  "type": "text"
                },
                {
                  "key": "experience",
                  "value": "5 years",
                  "type": "text"
                },
                {
                  "key": "about",
                  "value": "Bác sĩ giỏi, nhiều kinh nghiệm",
                  "type": "text"
                },
                {
                  "key": "fees",
                  "value": "500",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "{\"street\":\"123 Đường Bác sĩ\",\"city\":\"Hà Nội\",\"country\":\"Việt Nam\"}",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/admin/add-doctor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "add-doctor"
              ]
            },
            "description": "Thêm một bác sĩ mới vào hệ thống. Cần phải gửi đầy đủ các thông tin bắt buộc và cần tải lên ảnh đại diện."
          }
        },
        {
          "name": "Danh sách tất cả Bác sĩ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/all-doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "all-doctors"
              ]
            },
            "description": "Lấy danh sách tất cả bác sĩ trong hệ thống, bao gồm cả thông tin chi tiết (ngoại trừ mật khẩu)"
          }
        },
        {
          "name": "Thay đổi trạng thái hoạt động của Bác sĩ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"docId\": \"{{docId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/change-availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "change-availability"
              ]
            },
            "description": "Chuyển đổi trạng thái hoạt động của bác sĩ (từ available sang unavailable hoặc ngược lại)"
          }
        }
      ],
      "description": "Các API quản lý bác sĩ trong hệ thống"
    },
    {
      "name": "3. Quản lý Lịch khám",
      "item": [
        {
          "name": "Danh sách tất cả Lịch khám",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "appointments"
              ]
            },
            "description": "Lấy danh sách tất cả các lịch khám trong hệ thống, bao gồm cả các lịch khám đã hủy, đã hoàn thành và đang chờ xử lý"
          }
        },
        {
          "name": "Hủy Lịch khám",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"appointmentId\": \"{{appointmentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/cancel-appointment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "cancel-appointment"
              ]
            },
            "description": "Hủy một lịch khám cụ thể. Admin có quyền hủy bất kỳ lịch khám nào trong hệ thống."
          }
        }
      ],
      "description": "Các API quản lý lịch khám trong hệ thống"
    },
    {
      "name": "4. Bảng điều khiển",
      "item": [
        {
          "name": "Thông tin Bảng điều khiển",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "dashboard"
              ]
            },
            "description": "Lấy các thông tin tổng hợp cho bảng điều khiển của Admin, bao gồm: số lượng bác sĩ, số lượng bệnh nhân, số lượng lịch khám và danh sách các lịch khám mới nhất"
          }
        }
      ],
      "description": "API lấy thông tin tổng hợp cho bảng điều khiển"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    }
  ]
}
