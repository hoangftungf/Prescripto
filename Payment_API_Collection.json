{
  "info": {
    "_postman_id": "c4ff5e31-6722-4810-8c0d-22d9c5b7ebf3",
    "name": "Prescripto Payment API Collection",
    "description": "Collection API cho phần thanh toán trong hệ thống Prescripto (Razorpay và Stripe)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Xác thực Người dùng",
      "item": [
        {
          "name": "Đăng nhập Người dùng",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "    pm.environment.set(\"userToken\", jsonData.token);",
                  "    console.log(\"Token đã được lưu: \" + jsonData.token);",
                  "} else {",
                  "    console.log(\"Lỗi khi đăng nhập: \" + jsonData.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@test.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            },
            "description": "Đăng nhập vào hệ thống với tài khoản người dùng"
          }
        }
      ],
      "description": "API xác thực dành cho người dùng"
    },
    {
      "name": "2. Lấy thông tin lịch khám",
      "item": [
        {
          "name": "Danh sách lịch khám",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.appointments && jsonData.appointments.length > 0) {",
                  "    pm.environment.set(\"appointmentId\", jsonData.appointments[0]._id);",
                  "    console.log(\"ID lịch khám đã được lưu: \" + jsonData.appointments[0]._id);",
                  "} else {",
                  "    console.log(\"Không có lịch khám hoặc lỗi\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "appointments"
              ]
            },
            "description": "Lấy danh sách các lịch khám của người dùng hiện tại"
          }
        }
      ],
      "description": "Lấy thông tin lịch khám cần thanh toán"
    },
    {
      "name": "3. Thanh toán Razorpay",
      "item": [
        {
          "name": "Tạo đơn hàng Razorpay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.order) {",
                  "    pm.environment.set(\"razorpayOrderId\", jsonData.order.id);",
                  "    console.log(\"Razorpay Order ID đã được lưu: \" + jsonData.order.id);",
                  "    console.log(\"Số tiền: \" + jsonData.order.amount/100 + \" \" + jsonData.order.currency);",
                  "} else {",
                  "    console.log(\"Lỗi khi tạo đơn hàng: \" + jsonData.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"appointmentId\": \"{{appointmentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/payment-razorpay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "payment-razorpay"
              ]
            },
            "description": "Tạo một đơn hàng mới trong Razorpay để thanh toán lịch khám"
          }
        },
        {
          "name": "Xác nhận thanh toán Razorpay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"razorpay_order_id\": \"{{razorpayOrderId}}\",\n    \"razorpay_payment_id\": \"pay_sample123456\",\n    \"razorpay_signature\": \"signature_sample123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/verifyRazorpay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "verifyRazorpay"
              ]
            },
            "description": "Xác nhận thanh toán sau khi người dùng đã hoàn tất thanh toán trên Razorpay"
          }
        }
      ],
      "description": "API thanh toán qua cổng Razorpay"
    },
    {
      "name": "4. Thanh toán Stripe",
      "item": [
        {
          "name": "Tạo phiên thanh toán Stripe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.session_url) {",
                  "    pm.environment.set(\"stripeSessionUrl\", jsonData.session_url);",
                  "    console.log(\"URL phiên thanh toán Stripe đã được lưu: \" + jsonData.session_url);",
                  "} else {",
                  "    console.log(\"Lỗi khi tạo phiên thanh toán: \" + jsonData.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "origin",
                "value": "http://localhost:5173"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"appointmentId\": \"{{appointmentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/payment-stripe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "payment-stripe"
              ]
            },
            "description": "Tạo một phiên thanh toán Stripe và nhận URL để chuyển hướng người dùng tới trang thanh toán Stripe"
          }
        },
        {
          "name": "Xác nhận thanh toán Stripe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"success\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/verifyStripe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "verifyStripe"
              ]
            },
            "description": "Xác nhận thanh toán sau khi người dùng đã hoàn tất thanh toán trên Stripe"
          }
        }
      ],
      "description": "API thanh toán qua cổng Stripe"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    }
  ]
}
