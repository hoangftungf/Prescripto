	"item": [
		{
			"name": "Doctor Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.json().success) {",
							"    pm.environment.set(\"doctorToken\", pm.response.json().token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"<DOCTOR_EMAIL>\",\n  \"password\": \"<DOCTOR_PASSWORD>\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/doctor/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"doctor",
						"login"
					]
				}
			},
			"response": []
		},
